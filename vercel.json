{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "ignoreCommand": "node scripts/vercel-ignore.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/music-search",
      "destination": "/api/music?__asechka_music=search"
    },
    {
      "source": "/api/daily-memory",
      "destination": "/api/together?__route=daily-memory"
    },
    {
      "source": "/api/camera",
      "destination": "/api/journal?__camera=1"
    },
    {
      "source": "/api/vault",
      "destination": "/api/journal?__vault=1"
    }
  ],
  "functions": {
    "api/games-socket.js": {
      "maxDuration": 300
    },
    "api/location.js": {
      "maxDuration": 30
    },
    "api/journal.js": {
      "includeFiles": "{dist/journal.json,private/camera.json,private/vault.json}",
      "maxDuration": 60
    },
    "api/together-photo.js": {
      "includeFiles": "{dist/together.json,dist/memories.json,dist/assets/photos/**}",
      "maxDuration": 60
    },
    "api/together.js": {
      "includeFiles": "{dist/together.json,dist/memories.json,dist/music.json}",
      "maxDuration": 60
    },
    "api/memories.js": {
      "includeFiles": "dist/memories.json",
      "maxDuration": 60
    },
    "api/music.js": {
      "includeFiles": "dist/music.json",
      "maxDuration": 60
    },
    "api/keepsakes.js": {
      "includeFiles": "dist/keepsakes.json",
      "maxDuration": 60
    }
  }
}
