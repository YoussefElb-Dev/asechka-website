{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/music-search",
      "destination": "/api/music?__asechka_music=search"
    },
    {
      "source": "/api/camera",
      "destination": "/api/journal?__camera=1"
    },
    {
      "source": "/api/location",
      "destination": "/api/journal?__location=1"
    },
    {
      "source": "/api/vault",
      "destination": "/api/journal?__vault=1"
    }
  ],
  "functions": {
    "api/games-socket.js": {
      "maxDuration": 300
    },
    "api/*.js": {
      "includeFiles": "{dist/*.json,dist/assets/photos/**,dist/assets/recipes/**,private/camera.json,private/vault.json}",
      "maxDuration": 60
    }
  }
}
