{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/music-search", "destination": "/api/music?__asechka_music=search" }
  ],
  "functions": {
    "api/games-socket.js": { "maxDuration": 300 },
